# Copiá este archivo como .env.local para desarrollo. En Vercel se cargan en
# Project → Settings → Environment Variables.
#
# Esta web no tiene panel ni base propios: la agencia la administra entera
# desde el panel Kuro (paquetes, ofertas, datos de la agencia, textos, reseñas)
# y todos los formularios llegan a su bandeja de Kuro.

# --- Obligatorias: conexión con el panel Kuro -----------------------------------
# KURO_API_URL: URL del proyecto Supabase de Kuro.
# KURO_ANON_KEY: su clave pública (publishable / anon). Nunca la de servicio.
# KURO_SITE_HOST: una dirección registrada en Kuro para esta agencia
#   (por ejemplo arrecife-viajes.kuro.site).
KURO_API_URL=
KURO_ANON_KEY=
KURO_SITE_HOST=

# --- Recomendadas -------------------------------------------------------------
# Dirección pública definitiva (canonical, sitemap). Si falta, se usa el
# dominio de producción de Vercel.
SITE_URL=https://www.tuagencia.com.ar

# --- Opcionales ---------------------------------------------------------------
# Dirección del panel Kuro (a donde lleva /panel). Por defecto
# https://panel.kuroautomation.com
KURO_PANEL_URL=

# Constancia por email del botón de arrepentimiento (resend.com). Los avisos de
# consultas al equipo los manda Kuro.
RESEND_API_KEY=
EMAIL_FROM="Web de la agencia <web@tuagencia.com.ar>"

# Anti-robots de Cloudflare Turnstile (gratis) en los formularios públicos.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Copiá este archivo como .env.local para desarrollo. En Vercel se cargan en
# Project → Settings → Environment Variables.
#
# Esta web NO tiene base de datos ni panel propio: todo el contenido comercial lo administra Kuro
# y la web lo consume por la Content API v1. Ver README.md.

# --- Kuro (obligatorias) --------------------------------------------------------
# Origen de la Content API de Kuro, sin /api/v1 (ej.: https://api.kuroautomation.com).
KURO_CONTENT_API_URL=
# Identificador PÚBLICO (no secreto) del sitio en Kuro (ej.: site_xxxxxxxxxxxxxxxxxxxxxxxx).
KURO_SITE_KEY=

# --- Recomendadas ---------------------------------------------------------------
# Dirección pública definitiva (canonical, sitemap, datos estructurados).
# Si falta, se usa el dominio de producción de Vercel.
SITE_URL=https://www.tuagencia.com.ar

# --- Opcionales (integraciones propias de la web) ---------------------------------
# Constancia por email del botón de arrepentimiento (resend.com).
RESEND_API_KEY=
EMAIL_FROM="Web de la agencia <web@tuagencia.com.ar>"
# A quién avisar de las solicitudes de arrepentimiento (separados por coma). Si falta, al email de la agencia en Kuro.
NOTIFY_EMAIL=

# Anti-robots de Cloudflare Turnstile (gratis) en los formularios públicos.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google: medición (GA4, solo con consentimiento de cookies) y verificación de Search Console.
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

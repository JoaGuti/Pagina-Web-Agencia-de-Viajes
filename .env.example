# Copiá este archivo como .env.local para desarrollo. En Vercel se cargan en
# Project → Settings → Environment Variables.

# --- Obligatorias en Vercel ---------------------------------------------------
# Base de datos Postgres (Neon desde el Marketplace de Vercel la completa sola).
# En desarrollo, si no está, se usa una base local embebida en .data/
DATABASE_URL=

# Primera cuenta de administración: se crea sola en el primer ingreso al panel.
# La contraseña necesita 8 caracteres, una mayúscula, un número y un símbolo.
# Después del primer ingreso, cambiala desde el panel ("Cambiar mi contraseña").
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Recomendadas -------------------------------------------------------------
# Dirección pública definitiva (canonical, sitemap, enlaces de invitación).
# Si falta, se usa el dominio de producción de Vercel.
SITE_URL=https://www.tuagencia.com.ar

# Fotos y logo: se completa sola al conectar un Blob Store en Vercel (Storage → Blob).
BLOB_READ_WRITE_TOKEN=

# "false" = arrancar sin los paquetes de ejemplo (web vacía para cargar desde cero).
SEED_DEMO=true

# --- Opcionales ---------------------------------------------------------------
# Avisos por email de cada consulta y recuperación de contraseña (resend.com).
RESEND_API_KEY=
EMAIL_FROM="Web de la agencia <web@tuagencia.com.ar>"
# A quién avisar de las consultas (separados por coma). Si falta, al email de la agencia.
NOTIFY_EMAIL=

# Anti-robots de Cloudflare Turnstile (gratis) en los formularios públicos.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Métricas de Google en el resumen del panel: JSON de una cuenta de servicio
# de Google Cloud (tal cual o en base64). Ver README.
GOOGLE_SERVICE_ACCOUNT=
